# Hashed build assets never change under the same name — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand fonts are stable too, and every page waits on them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The invitation itself must always be the latest one.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The admin panel embeds this site to preview unsaved edits. Naming it here
  # allows exactly that and closes what was open to everyone: with no
  # frame-ancestors at all, any site on the internet could frame the
  # invitation inside its own chrome.
  Content-Security-Policy: frame-ancestors 'self' https://admin.jadeejoao.com.br
